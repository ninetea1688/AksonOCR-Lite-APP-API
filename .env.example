OCR_DEVICE=cpu
OCR_DEWARP=false
OCR_TABLES=true
OCR_MAX_UPLOAD_MB=20
OCR_MAX_PAGES=10
OCR_MAX_PIXELS=25000000
# Docker Compose: publish locally; use APP_HOST=0.0.0.0 for LAN access
APP_HOST=127.0.0.1
APP_PORT=8000
OCR_CPUS=2.0
OCR_MEMORY_LIMIT=4g
AKSONOCR_THREADS=2
# Optional: directory containing model weights for offline use
# AKSONOCR_WEIGHTS=/path/to/weights
